# Local development environment overrides.
# Copy to `.env` (gitignored). Every value here is a safe local default.

ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://agent_ant:agent_ant@localhost:5432/agent_ant

# Twilio — Week 1 (#18-#21)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# LLM — Week 2 (#22-#24). Use a paid tier with a UK/EU DPA before any live customer data.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
