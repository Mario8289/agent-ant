# Local development environment overrides.
# Copy to `.env` (gitignored). Every value here is a safe local default.

ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://agent_ant:agent_ant@localhost:5432/agent_ant
# Database for the tests that need real Postgres. They run migrations and TRUNCATE raw_events,
# so use a throwaway database. Unset: those tests skip locally and fail in CI.
TEST_DATABASE_URL=

# Twilio — Week 1 (#18-#21)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# LLM — Week 2 (#22-#24). Provider is swappable for the MVP (D-009); Bedrock preferred.
# Bedrock uses the standard AWS credential chain, so LLM_API_KEY is only for key-based APIs.
# No real customer data until a paid, DPA-backed provider is locked at the Week 4 gate (#29).
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
