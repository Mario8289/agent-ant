# Local development environment overrides.
# Copy to `.env` (gitignored). Every value here is a safe local default.

ENVIRONMENT=local
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://agent_ant:agent_ant@localhost:5432/agent_ant
# Database for the tests that need real Postgres. They run migrations and TRUNCATE raw_events,
# so use a throwaway database. Unset: those tests skip locally and fail in CI.
TEST_DATABASE_URL=

# Twilio — Week 1 (#18-#21)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Named in the auto-SMS, e.g. "Dave's Joinery". Unset: the text has no name.
BUSINESS_NAME=
# Public base URL Twilio calls, no trailing slash. Needed when the app is behind a proxy or
# tunnel (ngrok), because Twilio signs the exact URL it requested.
PUBLIC_BASE_URL=

# LLM — Week 2 (#22-#24). Provider is swappable for the MVP (D-009); Bedrock preferred.
# Bedrock uses the standard AWS credential chain, so LLM_API_KEY is only for key-based APIs.
# Bedrock has no API key: leave LLM_API_KEY empty, and do NOT set AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY here — the app reads AWS_PROFILE -> ~/.aws/credentials, not keys from
# .env. No real customer data until a paid, DPA-backed provider is locked at the Week 4 gate.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Bedrock (Week 2). Region is London (D-009); inference may be an eu.* cross-region profile
# that stays in EU geography (D-015), never global.*.
AWS_REGION=eu-west-2
# Named profile from ~/.aws/credentials. Create it with:
#   aws configure --profile agent-ant   (paste Access key ID + Secret, region eu-west-2)
# This is read by Settings and passed to boto3, so it works from .env; plain AWS_PROFILE
# would not, because pydantic-settings does not export .env to the environment.
AWS_PROFILE=agent-ant
